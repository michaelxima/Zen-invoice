# PostgreSQL URL. In production use a TLS-enabled managed database and pooled connection string.
DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Remote databases are always reached over TLS that verifies the certificate AND hostname (verify-full).
# Only localhost/127.0.0.1/::1 may use plain TCP. Don't put sslmode=require/prefer in DATABASE_URL: it is refused.
# If your provider's certificate isn't signed by a public CA, download its CA certificate and point to the file:
DATABASE_SSL_ROOT_CERT=
POSTGRES_POOL_MAX=1

# Canonical application origin. Use the production HTTPS origin in deployment.
NEXTAUTH_URL=http://localhost:3005
NEXTAUTH_SECRET=replace_with_at_least_32_random_bytes
# Google sign-in is out of scope for v1 and stays off unless GOOGLE_SIGNIN_ENABLED=1 is also set.
# It never links a Google login to an existing account by email; see src/lib/auth/session-rules.ts.
GOOGLE_SIGNIN_ENABLED=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI parsing is optional. Do not enable without authentication, size limits, and privacy notice.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Stripe Connect Standard OAuth: configure the Connect platform client ID and secret in the secret manager.
STRIPE_CONNECT_CLIENT_ID=ca_...
STRIPE_SECRET_KEY=sk_test_...
# Configure this endpoint in Stripe to receive connected-account events.
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend transactional email. Sender must be a verified domain/address.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Invoice Claw <invoices@example.com>

# Disposable test database for the browser suite, seed and test migrations.
# Put this in .env.test.local (git-ignored), not .env.local. The name must end in _test and the host must be
# this machine; ALLOW_REMOTE_TEST_DATABASE=1 permits a throwaway remote database (still *_test).
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/invoice_claw_test
# E2E_PORT=3105
# ALLOW_REMOTE_TEST_DATABASE=

# Required by the AI parser when AI is enabled (AI is out of scope for v1).
GEMINI_MODEL=
